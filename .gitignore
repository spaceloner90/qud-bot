# Live run data: snapshots, the call log (hundreds of MB), voice and panel files. Rebuilt by every run.
live/

# Decompiled game code, regenerated by tools/dump_types.ps1 and tools/find_*.ps1 (not ours to publish)
research/il__*.txt
research/il_*.txt
research/types.txt

# The engine's own log, which includes machine and account details
Player.log

# Python and editor leftovers
__pycache__/
*.pyc
*.tmp
*.applying

# Local Claude Code settings (machine paths, permissions)
.claude/settings.local.json

# Machine-specific paths (the game's install folder): local/paths.json, read by tools/game_dir.ps1
local/
